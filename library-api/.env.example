# Salin menjadi .env (jangan commit file .env).
# Tanpa variabel ini API memakai penyimpanan memori + data contoh.

SUPABASE_URL=https://YOUR_PROJECT.supabase.co
# Gunakan service role key di server. Jangan taruh key ini di frontend.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Opsional, hanya untuk pengujian tanggal (format YYYY-MM-DD, zona logika WIB).
# LOAN_TODAY=2026-10-10

PORT=3001
